@Library('shared-lib') _

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = 'sama2alaa/demoapp'
        APP_DIR = 'Jenkins/Lab21/DemoApp'
        DOCKER_CREDENTIALS_ID = 'dockerhub-creds'
        GITHUB_CREDENTIALS_ID = 'github-creds'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                buildApp()
            }
        }

        stage('Build, Scan and Push Image') {
            steps {
                buildAndPushImage()
            }
        }

        stage('Update GitOps Manifest') {
            steps {
                script {
                    def updateManifest = load 'Jenkins/Lab23/vars/deployToK8s.groovy'
                    updateManifest()
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }
        success {
            echo 'SUCCESS: GitOps manifest pushed to GitHub!'
        }
        failure {
            echo 'FAILURE: Check Console Output.'
        }
    }
}
